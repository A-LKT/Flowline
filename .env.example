# Copy to .env and fill in. Used by docker-compose and `npm run dev`.

# Base URL the WhatsApp bridge and sidecars use to reach the backend.
# On the host (npm run dev) the bridge container can't resolve the compose
# service name "app" — use host.docker.internal instead.
WORKFLOW_ENGINE_URL=http://app:3001

# Must match the secret field on every webhook trigger configured in the UI.
WEBHOOK_SECRET=change-me

# Require this token on every API request (Authorization: Bearer <token>).
# Strongly recommended — without it, anyone who can reach the port has full access.
# API_TOKEN=change-me

# Voice-to-text (Whisper) sidecar.
VOICE_TO_TEXT_URL=http://voice-to-text:9000
WHISPER_MODEL=base

# Ollama plugin — URL of your Ollama instance when running the backend on the host.
OLLAMA_URL=http://localhost:11434

# URL the voice-to-text container uses to download audio files from the backend.
FILES_INTERNAL_BASE_URL=http://app:3001

# Premium license token (optional). Leave unset for the free edition.
# FLOWLINE_LICENSE_KEY=
