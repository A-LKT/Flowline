# Copy to .env and fill in. Used by docker-compose and `npm run dev`.

# Base URL the WhatsApp bridge and sidecars use to reach the backend.
# On the host (npm run dev) the bridge container can't resolve the compose
# service name "app" — use host.docker.internal instead.
WORKFLOW_ENGINE_URL=http://app:3001

# Must match the secret field on every webhook trigger configured in the UI.
WEBHOOK_SECRET=change-me

# ─── Login (required) ─────────────────────────────────────────────────────────
# The single account that can access the app. The backend REFUSES TO START unless
# a password is configured — Flowline is never reachable unauthenticated.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
# Preferred over plaintext: a hash keeps the cleartext password out of this file.
# Generate one with `cd backend && npm run auth:hash-password -- 'your-password'`
# and set it here (it takes precedence over AUTH_PASSWORD):
# AUTH_PASSWORD_HASH=scrypt$...
# Session lifetime in hours (default 168 = 7 days).
# AUTH_SESSION_TTL_HOURS=168
# Mark the session cookie Secure (default: on when NODE_ENV=production). Requires
# serving over HTTPS. Set to false only for local HTTP testing.
# AUTH_COOKIE_SECURE=true
# Behind a reverse proxy, set this so the real client IP (from X-Forwarded-For) is
# used for login throttling and logs. true, a hop count, or a CIDR/IP allowlist.
# Leave unset when the app is directly exposed (clients could otherwise spoof IPs).
# TRUST_PROXY=true

# Voice-to-text (Whisper) sidecar.
VOICE_TO_TEXT_URL=http://voice-to-text:9000
WHISPER_MODEL=base

# Ollama plugin — URL of your Ollama instance when running the backend on the host.
OLLAMA_URL=http://localhost:11434

# URL the voice-to-text container uses to download audio files from the backend.
FILES_INTERNAL_BASE_URL=http://app:3001

# Premium license token (optional). Leave unset for the free edition.
# FLOWLINE_LICENSE_KEY=
